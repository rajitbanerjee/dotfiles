#!/bin/bash
# Set up a new Amazon Linux 2023 instance with my preferred packages.
# Usage: setup-system-al2023

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/setup-system-common"

echo -e "Starting AL2023 system setup...\n"

setup_linux

brew_update
install_brew_utilities
install_herdr
install_docker_compose
install_go_yum
install_wakatime --break-system-packages
setup_workplace
install_builder_tools
configure_inotify_watches
install_ohmyzsh

echo -e "\nSystem setup complete!\n"
