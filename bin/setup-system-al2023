#!/bin/bash
# Set up a new Amazon Linux 2023 instance with my preferred packages.
# Usage: setup-system-al2023

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/setup-system-common"

echo -e "Starting AL2023 system setup...\n"

sudo timedatectl set-timezone Europe/Dublin

echo "Generating Midway cookie..."
mwinit -s -o

setup_linuxbrew
sudo yum install procps-ng

brew_update
install_brew_utilities
install_docker_compose
install_node_amazon --force  # alt: axe init builder-tools
install_go_yum
install_java_corretto
install_rust
install_wakatime --break-system-packages

install_aws_dev_tools
brew install awscurl
brazil setup completion

configure_inotify_watches
install_ohmyzsh

# Kitty (Optional)
# sudo tic ~/.config/kitty/xterm-kitty.ti

echo -e "\nSystem setup complete!\n"
