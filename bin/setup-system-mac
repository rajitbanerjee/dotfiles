#!/bin/bash
# Set up a new macOS system with my preferred packages.
# Usage: setup-system-mac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/setup-system-common"

echo -e "Starting macOS system setup...\n"

install_homebrew
brew update
brew upgrade
sudo chown -R $(whoami) $(brew --prefix)/*

install_brew_utilities
brew install wget
install_node_mac
install_go_brew
install_python_mac
install_java_mac
install_rust
install_wakatime
install_ohmyzsh

echo -e "\nSystem setup complete!\n"
