#!/bin/bash
# Set up a new macOS system with my preferred packages.
# Usage: setup-system-mac
# Requires Homebrew, installed in README step 1 before cloning this repo.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/setup-system-common"

echo -e "Starting macOS system setup...\n"

brew_update
install_brew_utilities
install_herdr
install_builder_tools
install_wakatime
install_ohmyzsh

finish
