#!/bin/bash
# Common setup functions shared across OS-specific setup scripts.
# Source this file, don't execute it directly.

set -uo pipefail
IFS=$'\n\t'

# Skip y/n prompts from Homebrew and mise.
export NONINTERACTIVE=1
export MISE_YES=1

FAILED=""

# Run a command; on failure, record it and keep going.
step() {
    "$@" && return
    local IFS=' '
    FAILED+="  $*"$'\n'
    echo "!! Failed: $*" >&2
}

# Print the failed steps, if any, and exit non-zero.
finish() {
    if [ -n "$FAILED" ]; then
        echo -e "\nSetup finished with failures:\n"
        printf '%s' "$FAILED"
        exit 1
    fi
    echo -e "\nSystem setup complete!\n"
}

brew_install() {
    for pkg in "$@"; do
        step brew install "$pkg"
    done
}

brew_install_cask() {
    for pkg in "$@"; do
        step brew install --cask "$pkg"
    done
}

# --- Universal functions ---

install_homebrew() {
    step /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

brew_update() {
    step brew analytics off
    step brew update
    step brew upgrade
}

install_brew_utilities() {
    echo -e "\n\nMisc. utilities:\n"
    brew_install duf eza fzf git-delta jq neovim pandoc pipx ripgrep tmux trash-cli watchman
}

install_herdr() {
    echo -e "\n\nherdr:\n"
    step sh -c 'curl -fsSL https://herdr.dev/install.sh | sh'
}

install_docker_compose() {
    step mkdir -p ~/.local/bin
    step curl -fL "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o ~/.local/bin/docker-compose
    step chmod +x ~/.local/bin/docker-compose
}

install_wakatime() {
    echo -e "\n\nWakaTime:\n"
    step pipx ensurepath
    step pipx install wakatime
    if [ ! -f ~/.wakatime.cfg ]; then
        if [ -z "${WAKATIME_API_KEY:-}" ]; then
            echo "Skipping ~/.wakatime.cfg: set WAKATIME_API_KEY and rerun to create it."
            return
        fi
        local key="$WAKATIME_API_KEY"
        echo -e """[settings]
debug = false
hidefilenames = false
ignore =
    COMMIT_EDITMSG$
    PULLREQ_EDITMSG$
    MERGE_MSG$
    TAG_EDITMSG$
api_key=$key
""" >~/.wakatime.cfg
    fi
}

install_ohmyzsh() {
    echo -e "\n\noh-my-zsh:\n"
    RUNZSH=no KEEP_ZSHRC=yes step sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
}

# --- Linux-only (AL2 / AL2023) shared functions ---

setup_linux() {
    step sudo timedatectl set-timezone Europe/Dublin

    echo "Generating Midway cookie..."
    step mwinit -s -o

    install_homebrew
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    step sudo yum groupinstall -y 'Development Tools'
    step sudo yum install -y procps-ng
    step sudo tic ~/.config/ghostty/xterm-ghostty.ti
}

install_builder_tools() {
    echo -e "\n\nBuilder tools:\n"
    step toolbox install axe
    step axe init builder-tools
    step mise install nodejs@20
    step mise use --global nodejs@20

    step toolbox install kiro-cli
    step toolbox install claude-code
    step toolbox install aim

    step aim agents install AIPowerUserCapabilities
    step aim plugins install AmazonBuilderCoreAIAgents
}

setup_workplace() {
    local owner="${1:-${USER}}"
    step sudo mkdir -p -m 755 /workplace/${USER}
    step sudo chown -R "$owner" /workplace/${USER}
    [ -e ~/workplace ] || step ln -s /workplace/${USER} ~/workplace
}

configure_inotify_watches() {
    step sh -c 'echo fs.inotify.max_user_watches=524288 | sudo tee -a /etc/sysctl.conf && sudo sysctl -p'
}
