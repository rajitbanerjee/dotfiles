#!/bin/bash
# Common setup functions shared across OS-specific setup scripts.
# Source this file, don't execute it directly.

set -euo pipefail
IFS=$'\n\t'

# --- Universal functions ---

install_homebrew() {
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
}

brew_update() {
    brew analytics off
    brew update
    brew upgrade
}

install_brew_utilities() {
    echo -e "\n\nMisc. utilities:\n"
    brew install bat
    brew install dpkg
    brew install duf
    brew install eza
    brew install fzf
    brew install git-delta
    brew install jq
    brew install neovim
    brew install pandoc
    brew install ripgrep
    brew install tldr
    brew install tmux
    brew install trash-cli
    brew install watchman
}

install_docker_compose() {
    curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o ~/.local/bin/docker-compose
    chmod +x ~/.local/bin/docker-compose
}

install_go_brew() {
    echo -e "\n\nGo:\n"
    brew install go
    go env -w GOPROXY=direct
}

install_wakatime() {
    echo -e "\n\nWakaTime:\n"
    python3 -m pip install --user wakatime "${@}"
    if [ ! -f ~/.wakatime.cfg ]; then
        echo -e "\n\nWakaTime config file setup:\n"
        read -p "Enter WakaTime API Key: " key
        echo -e """[settings]
debug = false
hidefilenames = false
ignore =
    COMMIT_EDITMSG$
    PULLREQ_EDITMSG$
    MERGE_MSG$
    TAG_EDITMSG$
api_key=$key
""" >~/.wakatime.cfg
    fi
}

install_ohmyzsh() {
    echo -e "\n\noh-my-zsh:\n(Note: \"exit\" from oh-my-zsh to resume setup)\n"
    sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
    mv ~/.zshrc.pre-oh-my-zsh ~/.zshrc
}

# --- Linux-only (AL2 / AL2023) shared functions ---

setup_linux() {
    sudo timedatectl set-timezone Europe/Dublin

    echo "Generating Midway cookie..."
    mwinit -s -o

    install_homebrew
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    sudo yum groupinstall 'Development Tools'
    sudo yum install -y procps-ng
    sudo tic ~/.config/kitty/xterm-kitty.ti
}

install_go_yum() {
    echo -e "\n\nGo:\n"
    sudo yum install -y golang
}

install_go_al2() {
    install_go_brew
    sudo ln -s /home/linuxbrew/.linuxbrew/bin/go /usr/bin/go
}

install_builder_tools() {
    echo -e "\n\nBuilder tools:\n"
    toolbox install axe
    axe init builder-tools
    mise install nodejs@20 && mise use --global nodejs@20

    toolbox install kiro-cli
    toolbox install aim

    aim agents install AIPowerUserCapabilities
}

setup_workplace() {
    local owner="${1:-${USER}}"
    sudo mkdir -p -m 755 /workplace/${USER}
    sudo chown -R "$owner" /workplace/${USER}
    ln -s /workplace/${USER} ~/workplace
}

configure_inotify_watches() {
    echo fs.inotify.max_user_watches=524288 | sudo tee -a /etc/sysctl.conf && sudo sysctl -p
}
