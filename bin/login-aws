#!/bin/bash

if [[ $(uname -n) == dev-dsk* || $(uname -n) == ip-*  ]]; then
	echo "Generating Midway cookie..."
	mwinit -s -o
	echo "Done!"
else
	echo "Generating AEA Midway cookie..."
	mwinit -f
	ssh devdesk
	rc=$?
	printf '\033c'; stty sane
	(( rc != 0 )) && echo "ssh failed (exit $rc)" >&2
	exit $rc
fi
