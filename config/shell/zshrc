# git
grb() {
    git rebase -i "HEAD~$1"
}

gsa() {
    GREEN='\033[0;32m'
    RESET='\033[0m'
    echoed=false
    find . -type d -name .git | awk -F"/.git$" '{print $1}' | while read -r f; do
        changes=$(cd "$f" && git status --porcelain)
        branch_status=$(cd "$f" && git status --branch --porcelain | grep -E '^\#\# .*ahead|behind')
        if [[ -n "$changes" || -n "$branch_status" ]]; then
            echo
            echo -e "${GREEN}... $f ...${RESET}"
            echo
            (cd "$f" && git -c color.ui=always status)
            echoed=true
        fi
    done

    $echoed || echo "tutto bene!"
}

gui() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: gui [skip|unskip|list] <file1> [file2 ...]"
        return 1
    fi

    local action=$1
    shift

    case "$action" in
        skip)
            if [[ $# -lt 1 ]]; then
                echo "Usage: gui skip <file1> [file2 ...]"
                return 1
            fi
            for file in "$@"; do
                git update-index --skip-worktree "$file"
                echo "Skipped tracking changes for $file"
            done
            ;;
        unskip)
            if [[ $# -lt 1 ]]; then
                echo "Usage: gui unskip <file1> [file2 ...]"
                return 1
            fi
            for file in "$@"; do
                git update-index --no-skip-worktree "$file"
                echo "Resumed tracking changes for $file"
            done
            ;;
        list)
            echo "Files with skip-worktree set:"
            git ls-files -v | grep '^[S]'
            ;;
        *)
            echo "Unknown action: $action"
            echo "Usage: gui [skip|unskip|list] <file1> [file2 ...]"
            return 1
            ;;
    esac
}

